[Unit]
Description=Veriflow monitor for existing authorized Apify runs
After=network-online.target
Wants=network-online.target

[Service]
User=veriflow
WorkingDirectory=/opt/veriflow
EnvironmentFile=/etc/veriflow.env
ExecStart=/opt/veriflow/.venv/bin/python -m veriflow apify-monitor
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
