# Server only. Use the direct Supabase PostgreSQL or session pooler URL with TLS.
DATABASE_URL=postgresql://veriflow_app:REPLACE@HOST:5432/postgres?sslmode=verify-full&sslrootcert=system
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Optional: owner-only configuration file outside this repository.
# VERIFLOW_ENV_FILE=/secure/veriflow/runtime.env
# SUPABASE_PROJECT_REF=qrejfpeclncrevmepgzx

# Primary collector. Token is server-side only. Zero USD disables paid starts.
APIFY_TOKEN=
APIFY_MAX_RUN_USD=0
APIFY_ROLLING_24H_BUDGET_USD=0
APIFY_MAX_RECORDS=20

# Remains false until published source rights and complete price/cost control are verified.
APIFY_PAID_RUNS_ENABLED=false

# Dashboard stays on loopback unless explicitly started with --host 0.0.0.0.
# PORT=8080

# Owner-only persistent export volume shared by dashboard and application-worker.
# VERIFLOW_ARTIFACT_DIR=/var/lib/veriflow/exports
