modules = ["nodejs-24", "python-3.12"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Veriflow Collection Worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Veriflow Private Dashboard"

[[workflows.workflow]]
name = "Veriflow Collection Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./.pythonlibs/bin/python -m veriflow worker"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Veriflow Private Dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./.pythonlibs/bin/python -m veriflow admin --host 0.0.0.0 --port 8099"
waitForPort = 8099

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[userenv]

[userenv.shared]
SUPABASE_PROJECT_REF = "qrejfpeclncrevmepgzx"
SUPABASE_SSL_ROOT_CERT = "/home/runner/workspace/attached_assets/0_prod-ca-2021_(1)_1794693377638.crt"
